{
  "name": "brease-site",
  "version": "1.0.0",
  "description": "An Astro website whose content is edited in Brease",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler dev",
    "deploy": "astro build && wrangler deploy",
    "check": "astro check"
  },
  "dependencies": {
    "astro": "7.4.2",
    "brease-client": "^0.8.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@types/node": "22.19.9",
    "typescript": "5.7.3",
    "wrangler": "4.152.0"
  },
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
