---
import { sectionAttrs } from 'brease-client'

import type { ClosingSection } from '@/lib/content'

type Props = { section: ClosingSection; index: number }
const { section, index } = Astro.props
const p = `sections.${index}`
---

<section class="closing" {...sectionAttrs(section)}>
  <div class="container">
    <h2 data-brease={`${p}.title`}>{section.title}</h2>
    <p data-brease={`${p}.text`}>{section.text}</p>
    <a class="button" href={section.cta.href} data-brease={`${p}.cta.label`}>{section.cta.label}</a>
  </div>
</section>
