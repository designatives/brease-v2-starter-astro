---
import { fieldPath, navPath } from 'brease-client'

import type { Global, NavLink } from '@/lib/brease'

// Shared texts from `_global`, links from the `footer` navigation.
type Props = { global: Global; links: NavLink[] }
const { global, links } = Astro.props
const g = (path: string) => (global.pageId ? fieldPath(path, global.pageId) : undefined)
---

<footer class="site-footer" data-brease-block="Footer">
  <div class="container footer-inner">
    <div>
      <p class="footer-name" data-brease={g('siteName')}>{global.content.siteName}</p>
      <p class="muted" data-brease={g('footer.text')}>{global.content.footer.text}</p>
    </div>
    <nav aria-label="Footer" data-brease={navPath('footer')}>
      {
        links.map((l) => (
          <a
            href={l.href}
            target={l.target === '_blank' ? '_blank' : undefined}
            rel={l.target === '_blank' ? 'noopener' : undefined}
          >
            {l.label}
          </a>
        ))
      }
    </nav>
  </div>
  <div class="container">
    <p class="muted small" data-brease={g('footer.copyright')}>{global.content.footer.copyright}</p>
  </div>
</footer>
